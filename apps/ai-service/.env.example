# LLM Provider Configuration
OPENAI_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=1.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# --- Local Inference Examples (uncomment to use) ---

# Ollama (after running: npm run services:up:ollama && ./docker/setup-ollama.sh)
# OPENAI_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# vLLM (after running: npm run services:up:vllm)
# OPENAI_API_KEY=vllm
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=meta-llama/Llama-3.2-1B-Instruct
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Ollama model selection (used by Docker Compose ollama profile)
# OLLAMA_MODEL=llama3.2

# vLLM model selection (used by Docker Compose vllm profile)
# VLLM_MODEL=meta-llama/Llama-3.2-1B-Instruct
