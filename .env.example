# ===========================================
# TACO-IDE Environment Variables
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ===========================================

# --- Database (obrigatorio) ---
DATABASE_URL=postgresql://local_user:your-password@localhost:5490/local_db
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=your-password

# --- Better Auth (obrigatorio - secret precisa de 32+ chars) ---
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# --- URLs ---
FRONTEND_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# --- Email (Resend) - opcional ---
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=noreply@taco-ide.com

# --- Cloudflare Turnstile - test key (use chave real em prod) ---
CLOUDFLARE_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Embeddings (opcional, mas necessario para Knowledge Base) ---
# EMBEDDING_PROVIDER=azure
# EMBEDDING_API_URL=https://<seu-recurso>.cognitiveservices.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-02-01
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- LLM (obrigatorio - chave Azure OpenAI ou similar) ---
LLM_API_BASE=https://<seu-recurso>.openai.azure.com/openai/v1/
LLM_API_KEY=replace-me
LLM_MODEL_NAME=gpt-5.2-chat

# --- OpenRouter (LLM alternativo para chat com TA) - opcional ---
# OPENROUTER_API_KEY=

# --- Platform admin seed (opcional, mas recomendado em dev) ---
# `npm run db:seed` provisiona o admin global usando essas 3 envs.
# Se a senha tiver caracteres especiais (#, $, ;), USE ASPAS — o dotenv
# trata `#` como comentario e corta a string sem aspas.
# Senha precisa ter no minimo 12 caracteres.
PLATFORM_ADMIN_EMAIL=admin@taco.dev
PLATFORM_ADMIN_PASSWORD="Teste123!@#$%"
PLATFORM_ADMIN_NAME=Platform Admin
