# ===========================================
# TACO-IDE Environment Variables
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ===========================================

# --- Database (obrigatorio) ---
DATABASE_URL=postgresql://local_user:your-password@localhost:5490/local_db
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=your-password

# --- Better Auth (obrigatorio - secret precisa de 32+ chars) ---
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# --- URLs ---
FRONTEND_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# --- Rate limiting (opcional; valores abaixo sao os padroes) ---
# Em memoria, por processo. Usuarios autenticados contam por usuario; anonimos
# por IP. Detalhes em apps/api/src/http/CLAUDE.md ("Rate limiting").
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL_PER_MINUTE=300
# RATE_LIMIT_AI_CHAT_PER_MINUTE=10
# RATE_LIMIT_AI_CHAT_PER_DAY=200
# RATE_LIMIT_AI_GENERATION_PER_MINUTE=5
# RATE_LIMIT_AI_GENERATION_PER_DAY=100
# RATE_LIMIT_EMBEDDING_PER_MINUTE=30
# RATE_LIMIT_EMBEDDING_PER_DAY=500
# Chaves por store (LRU); chaves despejadas tem o orcamento zerado.
# RATE_LIMIT_CACHE_SIZE=10000
# Proxies reversos confiaveis para X-Forwarded-For (IP do cliente usado nos
# limites). Vazio = nenhum (o cabecalho e ignorado). Em producao, informe o
# endereco do proxy, ex.: 127.0.0.1 (nginx no mesmo host) ou uniquelocal
# (proxy em rede Docker privada). "true" e contagem de saltos sao recusados.
# TRUST_PROXY=
# Better Auth (por IP e rota de auth). Padrao: ligado, exceto NODE_ENV=test.
# O contador so zera apos uma janela inteira sem requisicoes aceitas: o limite
# vale por rajada; ao atingi-lo, o IP espera uma janela apos a ultima aceita.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_SIGN_IN_PER_MINUTE=100
# AUTH_RATE_LIMIT_EMAIL_PER_HOUR=10

# --- Email (Resend) - opcional ---
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=noreply@taco-ide.com

# --- Cloudflare Turnstile - test key (use chave real em prod) ---
CLOUDFLARE_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Embeddings (opcional, mas necessario para Knowledge Base) ---
# EMBEDDING_PROVIDER=azure
# EMBEDDING_API_URL=https://<seu-recurso>.cognitiveservices.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-02-01
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- LLM (obrigatorio - chave Azure OpenAI ou similar) ---
LLM_API_BASE=https://<seu-recurso>.openai.azure.com/openai/v1/
LLM_API_KEY=replace-me
LLM_MODEL_NAME=gpt-5.2-chat

# --- Solucoes de referencia e avaliacao automatica ---
# Caminho principal: API do PDC. Sem PDC_API_URL, os dois geradores usam
# direto o OpenRouter. Peca o endereco ao time; nao o versione.
# PDC_API_URL=
# PDC_GABARITO_ENABLED=true
# PDC_REVIEW_ENABLED=true
# Fallback (e adaptador da revisao do PDC) via OpenRouter.
OPENROUTER_API_KEY=
# OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna

# --- Langfuse Observability (cloud) ---
# Obtenha as chaves em https://cloud.langfuse.com -> Settings -> API Keys
#
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=https://us.cloud.langfuse.com  # or https://cloud.langfuse.com for EU

# --- Platform admin seed (opcional, mas recomendado em dev) ---
# `npm run db:seed` provisiona o admin global usando essas 3 envs.
# Se a senha tiver caracteres especiais (#, $, ;), USE ASPAS — o dotenv
# trata `#` como comentario e corta a string sem aspas.
# Senha precisa ter no minimo 12 caracteres.
PLATFORM_ADMIN_EMAIL=admin@taco.dev
PLATFORM_ADMIN_PASSWORD="Teste123!@#$%"
PLATFORM_ADMIN_NAME=Platform Admin
