# ===========================================
# TACO-IDE Environment Variables
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ===========================================

# --- Database (obrigatorio) ---
DATABASE_URL=postgresql://local_user:your-password@localhost:5490/local_db
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=your-password

# --- Better Auth (obrigatorio) ---
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# --- URLs ---
FRONTEND_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# --- Email (Resend) - opcional ---
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=noreply@taco-ide.com

# --- Cloudflare Turnstile - opcional ---
# CLOUDFLARE_TURNSTILE_SECRET=

# --- OpenRouter (LLM para chat com TA) - opcional ---
# OPENROUTER_API_KEY=

# --- Langfuse Observability (self-hosted, opcional) ---
# Langfuse roda em containers Docker em ambos os ambientes (local e producao).
#
# Desenvolvimento local:
#   1. Inicie o stack: cd packages/infra && npm run langfuse:up
#   2. Acesse http://localhost:3200 (credenciais: admin@taco-ide.local / local-admin-password)
#   3. Use as chaves pre-configuradas abaixo
#
# Producao:
#   1. Deploy: docker compose -p langfuse_prod -f packages/infra/docker/compose.langfuse.prod.yaml up -d
#   2. Configure as variaveis de ambiente do servidor de producao (ver compose.langfuse.prod.yaml)
#   3. Use as chaves geradas na inicializacao (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / SECRET_KEY)
#
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev-public-key
# LANGFUSE_SECRET_KEY=sk-lf-local-dev-secret-key
# LANGFUSE_BASEURL=http://localhost:3200
