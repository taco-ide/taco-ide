{
  "name": "@repo/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/client": "./src/auth/client.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "services:up": "docker compose -p taco_ide -f ./docker/compose.yaml up -d",
    "services:stop": "docker compose -p taco_ide -f ./docker/compose.yaml stop",
    "services:down": "docker compose -p taco_ide -f ./docker/compose.yaml down -v",
    "db:generate": "dotenv -e ../../.env -- npx drizzle-kit generate --config ./drizzle.config.ts",
    "db:push": "dotenv -e ../../.env -- npx drizzle-kit push --config ./drizzle.config.ts",
    "db:migrate": "dotenv -e ../../.env -- npx drizzle-kit migrate --config ./drizzle.config.ts && npm run build",
    "db:studio": "dotenv -e ../../.env -- npx drizzle-kit studio --config ./drizzle.config.ts",
    "db:seed": "dotenv -e ../../.env -- npx tsx src/db/seed.dev.ts",
    "db:seed:dev": "dotenv -e ../../.env -- npx tsx src/db/seed.dev.ts",
    "db:seed:prod": "dotenv -e ../../.env -- npx tsx src/db/seed.prod.ts",
    "db:reset": "dotenv -e ../../.env -- npx tsx src/db/reset-db.ts && dotenv -e ../../.env -- npx drizzle-kit migrate --config ./drizzle.config.ts && dotenv -e ../../.env -- npx tsx src/db/seed.dev.ts",
    "db:reset:push": "dotenv -e ../../.env -- npx tsx src/db/reset-db.ts && dotenv -e ../../.env -- npx drizzle-kit push --config ./drizzle.config.ts --force && dotenv -e ../../.env -- npx tsx src/db/seed.dev.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.4.13",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.5",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
